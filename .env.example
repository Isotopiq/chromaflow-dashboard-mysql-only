# =====================================================================
# CHROMA.LAB — example environment for Easypanel / docker-compose.
# Copy values into Easypanel's Environment tab. Only the secrets below
# are required for a working deploy; everything else has a sensible
# default in docker-compose.yml.
# =====================================================================

# ---- App ----
# Comma-separated list of allowed hostnames, or "all" behind a trusted proxy.
ALLOWED_HOSTS=all
# Public URL of the deployment (used in password-reset email links).
APP_URL=https://your-domain.example.com
# Session JWT signing key. Generate with:  openssl rand -hex 32
JWT_SECRET=
# One-time bootstrap token for creating the first admin via the
# POST /api/public/bootstrap-admin API. Clear after first admin is created.
# Optional — prefer ADMIN_EMAIL/ADMIN_PASSWORD below for auto-bootstrap.
BOOTSTRAP_TOKEN=

# ---- First admin (auto-created on startup) ----
# Set these and the app will create the first admin user automatically on
# boot. Idempotent: if the user already exists, only the admin role is
# ensured (password is never overwritten). Leave unset to use the
# bootstrap-admin API endpoint instead.
ADMIN_EMAIL=admin@your-domain.example.com
ADMIN_PASSWORD=ChangeMeStrongPass123!
ADMIN_DISPLAY_NAME=Administrator

# ---- Postgres (bundled) ----
# Override the bundled DB credentials. If you change these, you MUST also
# set DATABASE_URL below to match.
POSTGRES_USER=chroma
POSTGRES_PASSWORD=chroma
POSTGRES_DB=chroma_lab
# Connection string. Defaults to the bundled postgres service over the
# internal Docker network. Only change if you point at an external DB.
DATABASE_URL=postgres://chroma:chroma@postgres:5432/chroma_lab
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- File storage ----
# Option A (default): local filesystem. Leave S3_* unset and uploads are
# stored in /app/data/uploads (persisted via a Docker volume). No external
# services required — works out of the box.
LOCAL_STORAGE_DIR=/app/data/uploads
#
# Option B: S3-compatible (R2, MinIO, AWS S3, etc.). Set S3_BUCKET and creds
# to use external object storage instead of the local filesystem.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
S3_FORCE_PATH_STYLE=false

# ---- SMTP (optional; required for password-reset emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
